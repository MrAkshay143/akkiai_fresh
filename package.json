{
  "name": "akki-ai",
  "version": "2.1.0",
  "description": "Akki AI Desktop — Production-Oriented Desktop AI Companion",
  "author": "Akshay Mondal",
  "main": "dist-electron/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "electron:start": "electron .",
    "pack": "npm run build && npm run build:electron && electron-builder --dir",
    "dist": "npm run build && npm run build:electron && electron-builder"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "@jitsi/robotjs": "^0.6.24",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "firebase": "^13.0.0",
    "google-auth-library": "^11.2.0",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.2",
    "playwright": "^1.64.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "screenshot-desktop": "^1.15.7",
    "serialport": "^13.0.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
